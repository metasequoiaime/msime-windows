// Generated by server/CMakeLists.txt from version_info.rc.in. Do not edit the copy in the build tree.
//
// Keep this file ASCII-only: rc.exe opens it with the system code page, and non-ASCII bytes make the
// generated resource depend on the build machine's locale.
//
// FILEVERSION keeps the four numeric fields apply_version.py stamps into the TSF DLL. ProductVersion
// is the display string (it may carry a -dev/-nightly suffix) so the About page and Explorer show the
// same version the user downloaded.

// The version block must be resource ordinal 1, which is what GetFileVersionInfo expects. Without
// this define rc.exe leaves VS_VERSION_INFO as an unresolved name, and the block lands under a
// string name that Windows never reads.
#define VS_VERSION_INFO 1

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MSIME_VERSION_QUAD@
 PRODUCTVERSION @MSIME_VERSION_QUAD@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Metasequoia"
            VALUE "FileDescription", "@MSIME_VERSION_DESCRIPTION@"
            VALUE "FileVersion", "@MSIME_VERSION_DOTTED@"
            VALUE "InternalName", "@MSIME_VERSION_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 Metasequoia IME Team"
            VALUE "OriginalFilename", "@MSIME_VERSION_ORIGINAL_FILENAME@"
            VALUE "ProductName", "Metasequoia IME"
            VALUE "ProductVersion", "@MSIME_PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
